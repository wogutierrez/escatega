---
import '../styles/styles.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, getAlternatePageUrl } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const currentUrl = new URL(Astro.url.pathname, Astro.site || 'https://escatega.com');
const alternateUrl = new URL(getAlternatePageUrl(Astro.url), Astro.site || 'https://escatega.com');

const enUrl = lang === 'en' ? currentUrl.href : alternateUrl.href;
const esUrl = lang === 'es' ? currentUrl.href : alternateUrl.href;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title || 'Escatega'}</title>
  {description && <meta name="description" content={description} />}

  <!-- SEO & Canonical Links -->
  <link rel="canonical" href={currentUrl.href} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="es" href={esUrl} />
  <link rel="alternate" hreflang="x-default" href={enUrl} />
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- FontAwesome for Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  
  <style>
    @import "https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=Roboto:wght@400;500&display=swap";
    :root {
      --eg-orange: #ff6b35;
      --eg-black: #111111;
      --eg-gray: #555555;
      --eg-light: #f8f9fa;
      --bs-body-font-family: "Roboto", sans-serif;
      --bs-heading-font-family: "Inter", sans-serif;
    }
    .text-primary, .btn-primary { color: var(--eg-orange) !important; }
    .btn-primary {
      background-color: var(--eg-orange) !important;
      border-color: var(--eg-orange) !important;
      color: #fff !important;
      font-weight: 600;
      transition: all .3s ease;
    }
    .btn-primary:hover {
      background-color: #e0531f !important;
      border-color: #e0531f !important;
    }
    .bg-dark { background-color: var(--eg-black) !important; }
    .text-secondary { color: var(--eg-gray) !important; }
    .navbar-brand img { max-height: 80px; }
    .hero-section { padding: 100px 0; }
    .feature-card { border: 1px solid transparent; transition: transform .3s ease, box-shadow .3s ease; }
    .feature-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px #00000014; }
  </style>
</head>
<body>
  <Navbar />

  <main>
    <slot />
  </main>

  <Footer />

  <!-- Bootstrap 5 Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>