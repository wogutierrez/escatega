---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '@i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
  <div class="container">
    <a class="navbar-brand" href={translatePath('/')}>
      <img src="/escatega-logo.png" alt="EscaTega Tech Mentorship & Solutions" />
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
        <li class="nav-item">
          <a class="nav-link" href={translatePath('/')}>{t('nav.home')}</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href={translatePath('/foundation')}>{t('nav.foundation')}</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href={translatePath('/about')}>{t('nav.about')}</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href={translatePath('/articles')}>{t('nav.articles')}</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href={translatePath('/contact')}>{t('nav.contact')}</a>
        </li>
        <li class="nav-item ms-lg-2">
          <LanguageSwitcher />
        </li>
        <li class="nav-item ms-lg-3">
          <a class="btn btn-primary btn-sm px-4 rounded-pill" href={translatePath('/foundation#apply')}>
            {t('buttons.applyNow')}
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>