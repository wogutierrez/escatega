---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Us | Escatega - Tech Mentorship & Solutions">
  
  <!-- ABOUT HERO SECTION -->
  <header class="py-5 bg-light border-bottom">
    <div class="container py-4 text-center">
      <p class="text-uppercase fw-bold mb-2 text-primary">Our Story[cite: 1]</p>
      <h1 class="display-4 fw-extrabold text-dark mb-3">Escatega[cite: 1]</h1>
      <h3
        class="fw-normal text-secondary mx-auto"
        style="max-width: 700px; font-size: 1.5rem"
      >
        <em
          >Empowering Your Success Through Technology and Business Insight</em
        >[cite: 1]
      </h3>
      <div
        class="mx-auto mt-4"
        style="width: 60px; height: 4px; background-color: #ff6b35"
      ></div>
    </div>
  </header>

  <!-- ORIGIN SECTION -->
  <section class="py-5 bg-white">
    <div class="container">
      <div class="row justify-content-center text-center mb-5">
        <div class="col-lg-8">
          <p class="lead text-dark fs-4">
            Escatega was founded by cousins
            <strong>William Ortega</strong> and <strong>Alan Carcamo</strong>,
            who combine over four decades of experience in technology and
            business. Our name represents our mission:
            <strong>Expert Solution from Carcamo and Ortega.</strong>[cite: 1]
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FOUNDERS PROFILES SECTION -->
  <section class="py-5 bg-light border-top border-bottom">
    <div class="container">
      <!-- William's Bio Grid -->
      <div class="row align-items-center g-5 mb-5 pb-5 border-bottom">
        <div class="col-lg-4 text-center order-lg-1">
          <div
            class="p-4 bg-white rounded-circle shadow-sm d-flex align-items-center justify-content-center border mx-auto"
            style="width: 240px; height: 240px"
          >
            <i
              class="fa-solid fa-network-wired text-primary mb-3"
              style="font-size: 5rem"
            ></i>
          </div>
        </div>
        <div class="col-lg-8 order-lg-2">
          <h2 class="fw-bold text-dark mb-1">William Ortega[cite: 1]</h2>
          <h5 class="mb-3 text-primary">
            The International Tech Mentor & Systems Leader[cite: 1]
          </h5>
          <p class="text-secondary">
            My 22-year journey in technology began hands-on, building and
            repairing computers in Nicaragua. I rapidly advanced to managing
            critical systems for banks and major institutions, eventually
            founding my own successful IT consulting firm.[cite: 1]
          </p>
          <p class="text-secondary">
            My career took a global turn when I joined the Jehovah’s Witnesses
            branch office, serving as a senior technician and IT Manager
            across Nicaragua, Mexico, and Zimbabwe. I was also selected to
            train new technicians in Malawi. In total, I’ve personally
            mentored over 20 people, many of whom now hold senior tech roles
            and run their own businesses.[cite: 1]
          </p>
          <div
            class="p-3 bg-white rounded border-start border-4 border-dark mt-3"
          >
            <p class="mb-0 fw-bold text-dark">
              "This path solidified my true calling: not just to maintain
              systems, but to empower people."[cite: 1]
            </p>
          </div>
        </div>
      </div>

      <!-- Alan's Bio Grid -->
      <div class="row align-items-center g-5">
        <div class="col-lg-4 text-center order-lg-2">
          <div
            class="p-4 bg-white rounded-circle shadow-sm d-flex align-items-center justify-content-center border mx-auto"
            style="width: 240px; height: 240px"
          >
            <i
              class="fa-solid fa-chart-line text-primary mb-3"
              style="font-size: 5rem"
            ></i>
          </div>
        </div>
        <div class="col-lg-8 order-lg-1">
          <h2 class="fw-bold text-dark mb-1">Alan Carcamo[cite: 1]</h2>
          <h5 class="mb-3 text-primary">The Entrepreneurial IT Strategist[cite: 1]</h5>
          <p class="text-secondary">
            Alan brings a powerful entrepreneurial spirit to Escatega. For over 20 years, he has successfully run his own IT consultancy in Nicaragua, providing reliable and skillful support to more than 10 different companies.[cite: 1]
          </p>
          <p class="text-secondary">
            But his expertise doesn’t stop there. Alan is a proven business
            builder with a remarkable track record of launching and managing
            diverse ventures, including retail stores and car dealerships.[cite: 1]
          </p>
          <div
            class="p-3 bg-white rounded border-start border-4 border-dark mt-3"
          >
            <p class="mb-0 fw-bold text-dark">
              This unique background gives him an unmatched understanding of
              how technology serves different business needs—from the server
              room to the sales floor. He knows what it takes for a business
              not just to run, but to grow and compete.[cite: 1]
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MISSION PURPOSE SECTION -->
  <section class="py-5 bg-dark text-white">
    <div class="container py-4">
      <div class="text-center mb-5">
        <h2 class="fw-bold">Why We Started Escatega[cite: 1]</h2>
        <p class="text-light opacity-75 mt-2">
          Clarity over complexity, practical solutions over empty theory.[cite: 1]
        </p>
        <div
          class="mx-auto mt-3"
          style="width: 40px; height: 3px; background-color: #ff6b35"
        ></div>
      </div>

      <div class="row g-4 justify-content-center">
        <!-- Audience 1 -->
        <div class="col-md-5">
          <div
            class="p-4 rounded-4 h-100"
            style="
              background-color: rgba(255, 255, 255, 0.05);
              border: 1px solid rgba(255, 255, 255, 0.1);
            "
          >
            <div class="mb-3 text-primary">
              <i class="fa-solid fa-graduation-cap fa-2x"></i>
            </div>
            <h4 class="fw-bold mb-3">For Aspiring Tech Professionals[cite: 1]</h4>
            <p class="opacity-75 mb-0">
              To guide young, aspiring tech professionals who feel
              overwhelmed, giving them the practical, real-world skills we
              wish we had when we started.[cite: 1]
            </p>
          </div>
        </div>

        <!-- Audience 2 -->
        <div class="col-md-5">
          <div
            class="p-4 rounded-4 h-100"
            style="
              background-color: rgba(255, 255, 255, 0.05);
              border: 1px solid rgba(255, 255, 255, 0.1);
            "
          >
            <div class="mb-3 text-primary">
              <i class="fa-solid fa-briefcase fa-2x"></i>
            </div>
            <h4 class="fw-bold mb-3">For Businesses & Busy Professionals[cite: 1]</h4>
            <p class="opacity-75 mb-0">
              To help businesses and busy professionals master the digital
              tools they need to thrive, without wasting their precious time.[cite: 1]
            </p>
          </div>
        </div>
      </div>

      <div class="text-center mt-5 pt-3">
        <h5 class="fw-bold mb-4 text-primary">
          Thank you for being here. We look forward to helping you master your
          technology journey.[cite: 1]
        </h5>
        <a
          href="/contact"
          class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm"
          >Connect With Us</a
        >
      </div>
    </div>
  </section>

</BaseLayout>