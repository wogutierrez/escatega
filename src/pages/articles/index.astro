---
// src/pages/articles/index.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');

// 1. Filter specifically for English content in the 'en/' folder
// 2. Sort articles by publication date (newest first)
const articles = allArticles
  .filter(entry => entry.id.startsWith('en/'))
  .sort((a, b) => 
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
  );

const categories = [
  "All",
  "Save Time & Stress",
  "Protect Your Business",
  "Get More Clients"
];
---

<BaseLayout title="Business Knowledge & Insights | ESCATEGA">
  <section class="py-5 bg-light">
    <div class="container py-4">
      
      <!-- Section Header -->
      <div class="text-center mx-auto mb-5" style="max-width: 700px;">
        <h1 class="display-5 fw-bold text-dark mb-3">Simple Solutions for Everyday Tech Challenges</h1>
        <p class="lead text-secondary mb-0">No heavy technical jargon—just practical guides to help you</p>
        <div
          class="mx-auto my-3"
          style="width: 60px; height: 4px; background-color: var(--eg-orange)"
        ></div>
      </div>

      <!-- Category Filter Pills -->
      <div class="d-flex flex-wrap justify-content-center gap-2 mb-5" id="category-filters">
        {categories.map((cat, index) => (
          <button 
            type="button" 
            class={`btn rounded-pill filter-btn px-4 fw-semibold ${index === 0 ? 'btn-primary active' : 'btn-outline-dark'}`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Article Grid -->
      <div class="row g-4" id="articles-grid">
        {articles.map((article) => {
          // Strip out 'en/' folder prefix to build a clean URL slug
          const cleanSlug = article.id.replace(/^en\//, '').replace(/\.[^/.]+$/, '');
          return (
            <div class="col-md-6 col-lg-4 article-card-wrapper" data-category={article.data.category}>
              <div class="card h-100 feature-card shadow-sm p-3 rounded-4 border-0">
                <div class="card-body d-flex flex-column">
                  <span 
                    class="badge align-self-start mb-3 rounded-pill px-3 py-2 fw-semibold text-white"
                    style="background-color: var(--eg-orange)"
                  >
                    {article.data.category}
                  </span>
                  <h3 class="h5 card-title fw-bold text-dark mb-2">{article.data.title}</h3>
                  <p class="card-text text-secondary flex-grow-1">{article.data.description}</p>
                  
                  <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                      {new Date(article.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                    </small>
                    <a href={`/articles/${cleanSlug}`} class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-semibold">
                      Read Article
                    </a>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>

    </div>
  </section>
</BaseLayout>

<script>
  function setupFilters() {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const articleCards = document.querySelectorAll('.article-card-wrapper');

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const selectedCategory = button.getAttribute('data-category');

        filterButtons.forEach(btn => {
          btn.classList.remove('btn-primary', 'active');
          btn.classList.add('btn-outline-dark');
        });
        button.classList.remove('btn-outline-dark');
        button.classList.add('btn-primary', 'active');

        articleCards.forEach(card => {
          const cardCategory = card.getAttribute('data-category');
          if (selectedCategory === 'All' || cardCategory === selectedCategory) {
            (card as HTMLElement).style.display = 'block';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  setupFilters();
  document.addEventListener('astro:page-load', setupFilters);
</script>