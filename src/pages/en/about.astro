---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Us | Escatega - Tech Mentorship & Solutions">
  <!-- HERO SECTION -->
  <header class="py-5 bg-light border-bottom">
    <div class="container py-4 text-center">
      <p class="text-uppercase fw-bold mb-2 text-primary">Our Story</p>
      <h1 class="display-4 fw-extrabold text-dark mb-3">Escatega</h1>
      <p class="lead text-secondary mx-auto" style="max-width: 700px;">
        Empowering your success through technology and practical business insight. We help professionals and businesses confidently navigate the changing tech landscape.
      </p>
      <div
        class="mx-auto mt-4"
        style="width: 60px; height: 4px; background-color: #ff6b35"
      ></div>
    </div>
  </header>

  <!-- ORIGIN & OVERVIEW SECTION -->
  <section class="py-5 bg-white">
    <div class="container">
      <div class="row justify-content-center text-center mb-5">
        <div class="col-lg-8">
          <span class="text-uppercase fw-bold text-primary" style="color: var(--eg-orange) !important;">Who We Are</span>
          <h2 class="fw-bold text-dark mt-2 mb-4">Founded on Integrity and Expertise</h2>
          <p class="lead text-dark fs-4">
            Escatega was founded by cousins
            <strong>William Ortega</strong> and <strong>Alan Carcamo</strong>,
            who combine over four decades of experience in technology and
            business. Our name represents our mission:
            <strong>Expert Solutions from Carcamo and Ortega.</strong>
          </p>
          <p class="text-secondary">
            At Escatega, we believe technology should be an empowering helper, not a source of stress. Built on a foundation of Christian values, we hold ourselves to the highest standards of honesty, direct communication, and reliable execution.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FOUNDERS PROFILES SECTION -->
  <section class="py-5 bg-light border-top border-bottom">
    <div class="container">
      <!-- William's Bio Grid -->
      <div class="row align-items-center g-5 mb-5 pb-5 border-bottom">
        <div class="col-lg-4 text-center order-lg-1">
          <div
            class="p-4 bg-white rounded-circle shadow-sm d-flex align-items-center justify-content-center border mx-auto"
            style="width: 240px; height: 240px"
          >
            <i
              class="fa-solid fa-network-wired text-primary mb-3"
              style="font-size: 5rem"
            ></i>
          </div>
        </div>
        <div class="col-lg-8 order-lg-2">
          <h2 class="fw-bold text-dark mb-1">William Ortega</h2>
          <h5 class="mb-3 text-primary">
            The International Tech Mentor & Systems Leader
          </h5>
          <p class="text-secondary">
            My 22-year journey in technology began hands-on, building and
            repairing computers in Nicaragua. I rapidly advanced to managing
            critical systems for banks and major institutions, eventually
            founding my own successful IT consulting firm.
          </p>
          <p class="text-secondary">
            My career took a global turn when I served as a senior technician and IT Manager across Nicaragua, Mexico, and Zimbabwe, as well as training new technicians in Malawi. In total, I’ve personally mentored over 20 people who now hold senior tech roles and run their own businesses.
          </p>
          <div class="mb-3">
            <a href="/ortega" class="text-decoration-none small fw-bold" style="color: var(--eg-orange) !important;">
              View System Architecture Profile &rarr;
            </a>
          </div>
          <div
            class="p-3 bg-white rounded border-start border-4 border-dark mt-3"
          >
            <p class="mb-0 fw-bold text-dark">
              "This path solidified my true calling: not just to maintain systems, but to empower people."
            </p>
          </div>
        </div>
      </div>

      <!-- Alan's Bio Grid -->
      <div class="row align-items-center g-5">
        <div class="col-lg-4 text-center order-lg-2">
          <div
            class="p-4 bg-white rounded-circle shadow-sm d-flex align-items-center justify-content-center border mx-auto"
            style="width: 240px; height: 240px"
          >
            <i
              class="fa-solid fa-chart-line text-primary mb-3"
              style="font-size: 5rem"
            ></i>
          </div>
        </div>
        <div class="col-lg-8 order-lg-1">
          <h2 class="fw-bold text-dark mb-1">Alan Carcamo</h2>
          <h5 class="mb-3 text-primary">The Entrepreneurial IT Strategist</h5>
          <p class="text-secondary">
            Alan brings a powerful entrepreneurial spirit to Escatega. For over 20 years, he has successfully run his own IT consultancy in Nicaragua, providing reliable and skillful support to more than 10 different companies.
          </p>
          <p class="text-secondary">
            Alan is a proven business builder with a remarkable track record of launching and managing diverse ventures, including retail stores and car dealerships.
          </p>
          <div
            class="p-3 bg-white rounded border-start border-4 border-dark mt-3"
          >
            <p class="mb-0 fw-bold text-dark">
              This unique background gives him an unmatched understanding of how technology serves different business needs—from the server room to the sales floor.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MISSION PURPOSE SECTION -->
  <section class="py-5 bg-dark text-white">
    <div class="container py-4">
      <div class="text-center mb-5">
        <h2 class="fw-bold">Why We Started Escatega</h2>
        <p class="text-light opacity-75 mt-2">
          Clarity over complexity, practical solutions over empty theory.
        </p>
        <div
          class="mx-auto mt-3"
          style="width: 40px; height: 3px; background-color: #ff6b35"
        ></div>
      </div>

      <div class="row g-4 justify-content-center">
        <!-- Audience 1 -->
        <div class="col-md-5">
          <div
            class="p-4 rounded-4 h-100"
            style="
              background-color: rgba(255, 255, 255, 0.05);
              border: 1px solid rgba(255, 255, 255, 0.1);
            "
          >
            <div class="mb-3 text-primary">
              <i class="fa-solid fa-graduation-cap fa-2x"></i>
            </div>
            <h4 class="fw-bold mb-3">For Aspiring Tech Professionals</h4>
            <p class="opacity-75 mb-0">
              To guide young, aspiring tech professionals who feel overwhelmed, giving them the practical, real-world skills we wish we had when we started.
            </p>
          </div>
        </div>

        <!-- Audience 2 -->
        <div class="col-md-5">
          <div
            class="p-4 rounded-4 h-100"
            style="
              background-color: rgba(255, 255, 255, 0.05);
              border: 1px solid rgba(255, 255, 255, 0.1);
            "
          >
            <div class="mb-3 text-primary">
              <i class="fa-solid fa-briefcase fa-2x"></i>
            </div>
            <h4 class="fw-bold mb-3">For Businesses & Busy Professionals</h4>
            <p class="opacity-75 mb-0">
              To help businesses and busy professionals master the digital tools they need to thrive, without wasting their precious time.
            </p>
          </div>
        </div>
      </div>

      <div class="text-center mt-5 pt-3">
        <h5 class="fw-bold mb-4 text-primary">
          Thank you for being here. We look forward to helping you master your technology journey.
        </h5>
        <a
          href="#contact"
          class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm"
          >Connect With Us</a
        >
      </div>
    </div>
  </section>

  <!-- INTEGRATED CONTACT SECTION -->
  <section id="contact" class="py-5 bg-light border-top">
    <div class="container py-4">
      <div class="row g-5">
        <!-- Contact Form Box -->
        <div class="col-lg-7">
          <div class="card p-4 border-0 shadow-sm bg-white rounded-4">
            <h3 class="fw-bold text-dark mb-4">Send Us a Message</h3>

            <form action="#" method="POST">
              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <div class="form-floating">
                    <input
                      type="text"
                      class="form-control"
                      id="firstName"
                      placeholder="John"
                      required
                    />
                    <label for="firstName">First Name</label>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="form-floating">
                    <input
                      type="text"
                      class="form-control"
                      id="lastName"
                      placeholder="Doe"
                      required
                    />
                    <label for="lastName">Last Name</label>
                  </div>
                </div>
              </div>

              <div class="mb-3">
                <div class="form-floating">
                  <input
                    type="email"
                    class="form-control"
                    id="emailAddress"
                    placeholder="name@example.com"
                    required
                  />
                  <label for="emailAddress">Email Address</label>
                </div>
              </div>

              <div class="mb-3">
                <div class="form-floating">
                  <select
                    class="form-select"
                    id="serviceInterest"
                    aria-label="Specify your interest"
                    required
                  >
                    <option value="" selected disabled>Choose an option...</option>
                    <option value="mentorship">AI & Tech Mentorship</option>
                    <option value="automation">Business Automation Solutions</option>
                    <option value="foundation">The Digital Foundation Package</option>
                    <option value="other">General Inquiry</option>
                  </select>
                  <label for="serviceInterest">What can we help you with?</label>
                </div>
              </div>

              <div class="mb-4">
                <div class="form-floating">
                  <textarea
                    class="form-control"
                    id="messageText"
                    placeholder="Leave a comment here"
                    style="height: 150px"
                    required
                  ></textarea>
                  <label for="messageText">Tell us about your project or goals</label>
                </div>
              </div>

              <button
                type="submit"
                class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm py-3"
              >
                Submit Inquiry
              </button>
            </form>
          </div>
        </div>

        <!-- Partnership Sidebars & Details -->
        <div class="col-lg-5">
          <div class="h-100 d-flex flex-column justify-content-between">
            <div>
              <h3 class="fw-bold text-dark mb-3">Why Partner with Escatega?</h3>
              <p class="text-secondary mb-4">
                We don’t believe in overly complicated jargon or charging you for setups you don't actually own. Built completely on Christian values and strict integrity, our commitment guarantees clarity and practical results.
              </p>

              <div class="mb-4 d-flex align-items-start">
                <div class="text-primary me-3 mt-1">
                  <i class="fa-solid fa-envelope fa-xl"></i>
                </div>
                <div>
                  <h5 class="fw-bold text-dark mb-1">Corporate Communication</h5>
                  <p class="text-secondary mb-0">info@escatega.com</p>
                </div>
              </div>

              <div class="mb-4 d-flex align-items-start">
                <div class="text-primary me-3 mt-1">
                  <i class="fa-solid fa-clock fa-xl"></i>
                </div>
                <div>
                  <h5 class="fw-bold text-dark mb-1">Operating Hours</h5>
                  <p class="text-secondary mb-0">Monday – Friday: 9:00 AM – 5:00 PM</p>
                </div>
              </div>
            </div>

            <!-- Dark Callout Block -->
            <div class="p-4 bg-dark text-white rounded-4 mt-4">
              <p class="mb-0 small opacity-75">
                <i class="fa-solid fa-quote-left text-primary me-2"></i>
                Whether you are a young tech professional trying to land your next break, or an entrepreneur streamlining legacy procedures—we design technology explicitly around your terms.
              </p>
              <p class="mb-0 text-end fw-bold text-primary small mt-2">— William & Alan</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>