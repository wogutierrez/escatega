---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Thank You | Escatega">
  <header class="py-5 bg-light border-bottom">
    <div class="container py-4 text-center">
      <div class="mb-4 text-primary">
        <i class="fa-solid fa-circle-check fa-3x"></i>
      </div>
      <p class="text-uppercase fw-bold mb-2 text-primary">Message Received</p>
      <h1 class="display-4 fw-extrabold text-dark mb-3">
        Thank You for Reaching Out
      </h1>
      <p class="lead text-secondary mx-auto" style="max-width: 600px">
        We have successfully received your inquiry and will get back to you shortly. Redirecting you to the home page...
      </p>
      <div class="mx-auto mt-4" style="width: 60px; height: 4px; background-color: #ff6b35"></div>
      
      <div class="mt-4">
        <a href="/" class="btn btn-outline-primary rounded-pill px-4">
          Return to Home Now
        </a>
      </div>
    </div>
  </header>

  <!-- Auto-redirect script (redirects after 5 seconds) -->
  <meta http-equiv="refresh" content="5;url=/" />
</BaseLayout>