---
import BaseLayout from '@layouts/BaseLayout.astro';
import { useTranslations, useTranslatedPath } from '@i18n/utils';

const t = useTranslations('es');
const translatePath = useTranslatedPath('es');


---

<BaseLayout title="ESCATEGA | Prepara tus Habilidades para la Era de la IA">
  
  <header class="hero-section bg-white">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-6">
          <h1 class="display-4 fw-extrabold text-dark mb-3">
            Prepara tus Habilidades para la
            <span style="color: var(--eg-orange)">Era de la IA</span>
          </h1>
          <p class="lead text-secondary mb-4">
            “Te ayudamos a dominar herramientas de IA para potenciar tus habilidades, asegurar que siempre seas indispensable y trabajar con confianza en un mundo en constante cambio.”
          </p>
          <div class="d-flex gap-3">
            <a
              href="#learning-hub"
              class="btn btn-primary btn-lg px-4 rounded-pill shadow"
              >Centro de Aprendizaje</a
            >
            <a
              href={translatePath('/about')}
              class="btn btn-outline-dark btn-lg px-4 rounded-pill"
              >Nuestra Historia</a
            >
          </div>
        </div>
        <div class="col-lg-6 text-center">
          <img
            src="/helping_people_at_work_pos.jpg"
            alt="Expansión mental e integración tecnológica"
            class="img-fluid rounded-5 shadow-sm border"
          />
        </div>
      </div>
    </div>
  </header>

  <section id="learning-hub" class="py-5 bg-light">
    <div class="container py-4">
      <div class="text-center mb-5">
        <h2 class="fw-bold text-dark">Nuestros Pilares Principales de Servicio</h2>
        <div
          class="mx-auto my-2"
          style="width: 60px; height: 4px; background-color: var(--eg-orange)"
        ></div>
      </div>

      <div class="row g-4">
        <div class="col-md-4">
          <div class="card h-100 feature-card shadow-sm p-4 rounded-4">
            <div class="card-body d-flex flex-column">
              <div class="mb-3 text-primary">
                <i class="fa-solid fa-rocket fa-2x"></i>
              </div>
              <h4 class="card-title fw-bold mb-3">
                Lanza tu Emprendimiento Tecnológico
              </h4>
              <p class="card-text text-secondary mb-4">
                “¿Quieres iniciar tu propio negocio o hacer que el que ya tienes funcione mejor? Te brindamos las habilidades tecnológicas y la guía necesaria para usar la tecnología como tu aliada, alcanzando tus metas bajo tus propios términos.”
              </p>
              <a
                href="#book-session"
                class="btn btn-outline-dark mt-auto rounded-pill w-100"
                >Inicia tu Camino</a
              >
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card h-100 feature-card shadow-sm p-4 rounded-4">
            <div class="card-body d-flex flex-column">
              <div class="mb-3 text-primary">
                <i class="fa-solid fa-gears fa-2x"></i>
              </div>
              <h4 class="card-title fw-bold mb-3">
                Gestiona y Automatiza tu Negocio
              </h4>
              <p class="card-text text-secondary mb-4">
                “Obtén el mismo soporte técnico confiable de las grandes empresas. Nos encargamos de tus equipos, seguridad y tareas repetitivas para que te enfoques en hacer crecer tu negocio.”
              </p>
              <a
                href="#book-session"
                class="btn btn-outline-dark mt-auto rounded-pill w-100"
                >Explorar Soluciones</a
              >
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card h-100 feature-card shadow-sm p-4 rounded-4">
            <div class="card-body d-flex flex-column">
              <div class="mb-3 text-primary">
                <i class="fa-solid fa-cubes fa-2x"></i>
              </div>
              <h4 class="card-title fw-bold mb-3">La Fundación Digital</h4>
              <p class="card-text text-secondary mb-4">
                Deja de ser invisible en línea. Establece una identidad profesional completamente unificada con un sitio web personal a la medida, dominio empresarial y un motor de audiencia de alta conversión.
              </p>
              <a
                href={translatePath('/foundation')}
                class="btn btn-primary mt-auto rounded-pill w-100"
                >{t('buttons.applyNow')}</a
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-dark text-white position-relative">
    <div class="container py-4">
      <div class="row align-items-center g-5">
        <div class="col-lg-5">
          <h2 class="display-6 fw-bold">
            Construido sobre una Base de Valores Cristianos e Integridad
          </h2>
          <div
            class="my-3"
            style="
              width: 50px;
              height: 3px;
              background-color: var(--eg-orange);
            "
          ></div>
          <p class="text-light opacity-75">
            Nos regimos por los más altos estándares de claridad, comunicación directa e implementación confiable en cada hito con nuestros clientes.
          </p>
        </div>
        <div class="col-lg-7">
          <div
            class="p-4 bg-secondary bg-opacity-10 border border-secondary rounded-4"
          >
            <p class="lead mb-4">
              Reunimos más de 20 años de experiencia cada uno en tecnología y negocios.
            </p>
            <ul class="list-unstyled">
              <li class="mb-3 d-flex align-items-start">
                <i
                  class="fa-solid fa-circle-check text-primary me-3 mt-1"
                ></i>
                <span
                  ><strong>El Marco de William:</strong> Su trayectoria como administrador senior de sistemas para organizaciones internacionales garantiza que tu tecnología sea segura y altamente confiable.</span
                >
              </li>
              <li class="mb-3 d-flex align-items-start">
                <i
                  class="fa-solid fa-circle-check text-primary me-3 mt-1"
                ></i>
                <span
                  ><strong>La Visión de Alan:</strong> Su éxito como emprendedor liderando múltiples empresas significa que comprendemos tus necesidades operativas desde el primer día.</span
                >
              </li>
            </ul>
            <p class="mt-4 mb-0 fw-bold" style="color: var(--eg-orange)">
              Juntos, ofrecemos soluciones técnicamente sólidas y estratégicamente inteligentes.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="book-session" class="py-5 bg-white">
    <div class="container py-4">
      <div class="text-center mb-5">
        <h2 class="fw-bold text-dark">Reserva una Sesión Estratégica con Nosotros</h2>
        <p class="text-secondary lead">Selecciona una fecha y hora disponible a continuación para programar tu consulta.</p>
        <div
          class="mx-auto my-2"
          style="width: 60px; height: 4px; background-color: var(--eg-orange)"
        ></div>
      </div>

      <div 
        id="cal-booking-embed" 
        class="rounded-4 shadow-sm border"
        style="width:100%; height:100%; min-height:700px; overflow:scroll;"
      ></div>
    </div>
  </section>

  <script is:inline>
    (function (C, A, L) { 
      let p = function (a, ar) { a.q.push(ar); }; 
      let d = C.document; 
      C.Cal = C.Cal || function () { 
        let cal = C.Cal; 
        let ar = arguments; 
        if (!cal.loaded) { 
          cal.ns = {}; 
          cal.q = cal.q || []; 
          d.head.appendChild(d.createElement("script")).src = A; 
          cal.loaded = true; 
        } 
        if (ar[0] === "init") { 
          let api = function () { p(api, arguments); }; 
          let namespace = ar[1]; 
          api.q = api.q || []; 
          if (typeof namespace === "string") { 
            cal.ns[namespace] = cal.ns[namespace] || api; 
            p(cal.ns[namespace], ar); 
            p(cal, ["init", namespace]); 
          } else { 
            p(cal, ar); 
          } 
          return; 
        } 
        p(cal, ar); 
      }; 
    })(window, "https://app.cal.com/embed/embed.js", "init");

    Cal("init", { origin: "https://cal.com" });

    Cal("inline", {
      elementOrSelector: "#cal-booking-embed",
      calLink: "escatega-rodudl/technical-service",
      layout: "month_view"
    });

    Cal("ui", {
      styles: { branding: { brandColor: "#000000" } },
      hideEventTypeDetails: false,
      layout: "month_view"
    });
  </script>

</BaseLayout>